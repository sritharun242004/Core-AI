---
import katex from 'katex'

interface Props {
  latex: string
  display?: boolean
}

const { latex, display = true } = Astro.props
const html = katex.renderToString(latex, {
  displayMode: display,
  throwOnError: false,
  output: 'html',
  strict: 'warn'
})
---
<div class="math-block my-4" set:html={html} />
