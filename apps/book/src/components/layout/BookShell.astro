---
import { Font } from 'astro:assets'
import { SearchDialog, SearchOpener } from '../interactive/SearchDialog'
import Footer from './Footer.astro'
import ReadingProgressBar from './ReadingProgressBar.astro'
import Sidebar from './Sidebar.astro'
import '../../styles/global.css'
interface Props {
  title: string
  accent?: string
}
const { title, accent = 'var(--accent-p1)' } = Astro.props
---
<html lang="en" style={`--accent: ${accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Core AI</title>
    <script is:inline>
      // One committed playroom theme — force light regardless of saved preference.
      document.documentElement.dataset.theme = 'light'
    </script>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body class="playroom-bg text-fg font-body" style="font-weight: 700;">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-canvas focus:p-3">Skip to content</a>
    <div
      class="fixed inset-x-0 top-0 h-0.5 z-50 pointer-events-none"
      style="background: var(--gradient-roadmap);"
      aria-hidden="true"
    ></div>
    <ReadingProgressBar />
    <div class="flex fixed top-3 right-3 z-40 gap-2">
      <SearchOpener client:load />
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)_240px] min-h-screen">
      <Sidebar />
      <main id="main-content" class="px-4 lg:px-8 pt-20 pb-8 lg:pt-8 mx-auto w-full min-w-0 max-w-prose">
        <slot />
      </main>
      <aside class="hidden lg:block px-4 py-8" aria-label="Margin notes"></aside>
    </div>
    <Footer />
    <SearchDialog client:only="preact" />
  </body>
</html>
