---
import { getCollection } from 'astro:content'
const weeks = (await getCollection('weeks')).sort((a, b) => a.data.week - b.data.week)
---
<nav aria-label="Chapter navigation" class="hidden lg:block border-r border-border-soft p-6 sticky top-0 h-screen overflow-y-auto">
  <a href="/" class="font-display text-lg block mb-6">Core AI</a>

  <p class="text-xs uppercase tracking-wide text-fg-muted mt-1 mb-2">Weeks</p>
  <ol class="space-y-1 text-sm">
    {weeks.map((w) => (
      <li>
        <a href={`/weeks/${w.data.slug}`} class="block py-1 hover:text-accent-p1">
          <span class="text-fg-muted mr-2">W{String(w.data.week).padStart(2, '0')}</span>
          {w.data.title}
        </a>
      </li>
    ))}
  </ol>

  <p class="text-xs uppercase tracking-wide text-fg-muted mt-6 mb-2">Companies</p>
  <ul class="space-y-1 text-sm">
    <li><a href="/companies" class="block py-1 hover:text-accent-p1">7 × 25 matrix</a></li>
    <li><a href="/companies/compare" class="block py-1 hover:text-accent-p1">Compare</a></li>
  </ul>

  <p class="text-xs uppercase tracking-wide text-fg-muted mt-6 mb-2">Interview</p>
  <ul class="space-y-1 text-sm">
    <li><a href="/interview" class="block py-1 hover:text-accent-p1">Dashboard</a></li>
    <li><a href="/interview/coding-set" class="block py-1 hover:text-accent-p1">Coding set</a></li>
  </ul>

  <p class="text-xs uppercase tracking-wide text-fg-muted mt-6 mb-2">Extras</p>
  <ul class="space-y-1 text-sm">
    <li><a href="/how-to-study" class="block py-1 hover:text-accent-p1">How to study</a></li>
    <li><a href="/math-primer" class="block py-1 hover:text-accent-p1">Math primer</a></li>
    <li><a href="/paper-reading-protocol" class="block py-1 hover:text-accent-p1">Paper reading</a></li>
    <li><a href="/tech-writing" class="block py-1 hover:text-accent-p1">Tech writing</a></li>
    <li><a href="/glossary" class="block py-1 hover:text-accent-p1">Glossary</a></li>
  </ul>
</nav>
