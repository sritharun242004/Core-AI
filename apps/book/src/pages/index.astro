---
import { getCollection } from 'astro:content'
import BookShell from '../components/layout/BookShell.astro'
import { compareWeeks, weekLabel } from '../lib/weeks'

const weeks = (await getCollection('weeks')).sort((a, b) => compareWeeks(a.data, b.data))
const PART_META = [
  { title: 'Math & Programming',          caption: 'Linear algebra, calculus, probability, Python for ML',             accent: 'p1' },
  { title: 'Classical ML',                caption: 'Regression, trees, unsupervised, honest evaluation',               accent: 'p2' },
  { title: 'Deep Learning',               caption: 'Autograd, CNNs, sequence models, RL primer',                       accent: 'p3' },
  { title: 'Transformers & LLMs',         caption: 'Attention from scratch, pre-training, SFT/DPO, MoE & reasoning',   accent: 'p4' },
  { title: 'Systems & Production',        caption: 'Distributed training, inference engines, MLOps, safety',           accent: 'p5' },
  { title: 'Specialization & Interview',  caption: 'Pick two of three tracks, capstone, 7-day interview protocol',     accent: 'p6' },
] as const

const parts = PART_META.map((meta, i) => ({
  ...meta,
  part: i + 1,
  weeks: weeks.filter((w) => w.data.part === i + 1),
}))

const totalHours = weeks.reduce((sum, w) => sum + (w.data.hours ?? 20), 0)
---
<BookShell title="Home">
  <section class="relative -mx-4 lg:-mx-8 mb-24 overflow-hidden rounded-xl">
    <div
      class="absolute inset-0 opacity-80"
      style="background: var(--gradient-hero); filter: saturate(1.1);"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-x-0 top-0 h-1"
      style="background: var(--gradient-roadmap);"
      aria-hidden="true"
    ></div>
    <div class="relative px-6 py-16 lg:px-12 lg:py-24">
      <p class="font-mono text-xs uppercase tracking-widest text-fg">25 weeks · 7 labs · 3 tracks</p>
      <h1
        class="font-display text-5xl md:text-6xl lg:text-7xl leading-none mt-6 text-fg"
        style="letter-spacing: -0.03em;"
      >
        Core AI
      </h1>
      <p class="font-display text-2xl md:text-3xl text-fg mt-4" style="letter-spacing: -0.01em;">
        From foundation to frontier.
      </p>
      <p class="mt-6 max-w-xl text-fg/90 text-md leading-relaxed">
        A self-driven roadmap from the math you need to the systems people deploy. Each week ships one tested reference project, one company lens across seven labs, and one interview drill. Practice and feedback — not completion alone — establish interview readiness.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/weeks/week-01-linear-algebra"
          class="group inline-flex items-center gap-2 px-5 py-3 rounded-md bg-fg text-canvas font-medium hover:translate-x-0.5 transition-transform"
        >
          Start Week 1
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a
          href="/how-to-study"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-fg/40 text-fg font-medium hover:bg-fg/5 transition-colors"
        >
          How to study this book
        </a>
      </div>
      <dl class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-2xl text-fg">
        <div>
          <dt class="font-mono text-xs uppercase tracking-wider opacity-70">Weeks</dt>
          <dd class="font-display text-3xl mt-1">{weeks.length}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wider opacity-70">Study hours</dt>
          <dd class="font-display text-3xl mt-1">{totalHours}+</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wider opacity-70">Companies</dt>
          <dd class="font-display text-3xl mt-1">7</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wider opacity-70">Projects</dt>
          <dd class="font-display text-3xl mt-1">25</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="font-display text-3xl md:text-4xl" style="letter-spacing: -0.02em;">
      The six parts
    </h2>
    <p class="text-fg-muted mt-3 max-w-xl">
      Each month is one deliberately shaped arc. Each week inside it carries the same anatomy:
      hook → intuition → math → code → company lens → reference project → assignments → interview drill.
    </p>
  </section>

  <div class="grid gap-5 md:grid-cols-2 mb-24">
    {parts.map(({ part, title, caption, accent, weeks }) => (
      <article
        class="group relative overflow-hidden rounded-xl border border-border-soft bg-canvas-raised p-6 lg:p-8 transition-all hover:border-border-strong hover:-translate-y-0.5"
        style={`--accent: var(--accent-${accent}); --glow: var(--accent-glow-${accent}); --ink: var(--accent-ink-${accent});`}
      >
        <div
          class="absolute inset-x-0 top-0 h-1"
          style="background: var(--accent);"
          aria-hidden="true"
        ></div>
        <div
          class="absolute -right-16 -top-16 w-56 h-56 rounded-full opacity-40 blur-3xl pointer-events-none"
          style="background: var(--glow);"
          aria-hidden="true"
        ></div>
        <header class="relative flex items-baseline gap-3">
          <span
            class="font-mono text-xs uppercase tracking-widest"
            style="color: var(--ink);"
          >
            Month {part}
          </span>
          <span class="text-xs text-fg-muted">· {weeks.length} weeks</span>
        </header>
        <h3 class="relative font-display text-2xl mt-2" style="letter-spacing: -0.01em;">
          {title}
        </h3>
        <p class="relative text-sm text-fg-muted mt-2 max-w-md">{caption}</p>
        <ol class="relative mt-6 space-y-1.5">
          {weeks.map((w) => (
            <li>
              <a
                href={`/weeks/${w.data.slug}`}
                class="group/row flex items-center gap-3 py-1.5 -mx-2 px-2 rounded-sm hover:bg-canvas-subtle transition-colors"
              >
                <span
                  class="font-mono text-xs w-10 shrink-0"
                  style="color: var(--ink);"
                >
                  W{weekLabel(w.data)}
                </span>
                <span class="flex-1 group-hover/row:translate-x-0.5 transition-transform">{w.data.title}</span>
                <span class="text-xs text-fg-muted shrink-0">{w.data.hours}h</span>
              </a>
            </li>
          ))}
        </ol>
        {part === 6 && (
          <p class="relative mt-4 text-xs text-fg-muted">
            Pick 2 of 3 tracks (L · P · R). All six α/β lessons are available.
          </p>
        )}
      </article>
    ))}
  </div>

  <section class="mb-16 rounded-xl border border-border-soft bg-canvas-subtle p-6 lg:p-10">
    <h2 class="font-display text-3xl" style="letter-spacing: -0.02em;">
      Companies × Weeks matrix
    </h2>
    <p class="text-fg-muted mt-3 max-w-xl">
      Every week compares the same seven labs — OpenAI, Anthropic, Google DeepMind, Meta, xAI, DeepSeek, Alibaba Qwen — so comparisons compound. By Week 25, 175 interview angles are internalized.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/companies"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-fg text-canvas font-medium hover:translate-x-0.5 transition-transform"
      >
        Open the matrix →
      </a>
      <a
        href="/companies/compare"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-border-strong hover:bg-canvas transition-colors"
      >
        Compare on an axis
      </a>
    </div>
  </section>
</BookShell>
