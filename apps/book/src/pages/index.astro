---
import { getCollection } from 'astro:content'
import BookShell from '../components/layout/BookShell.astro'
import { compareWeeks, weekLabel } from '../lib/weeks'

const weeks = (await getCollection('weeks')).sort((a, b) => compareWeeks(a.data, b.data))
const PART_META = [
  { title: 'Math & Programming',          caption: 'Linear algebra, calculus, probability, Python for ML',             accent: 'p1', color: 'blue',   glyph: '1' },
  { title: 'Classical ML',                caption: 'Regression, trees, unsupervised, honest evaluation',               accent: 'p2', color: 'green',  glyph: '2' },
  { title: 'Deep Learning',               caption: 'Autograd, CNNs, sequence models, RL primer',                       accent: 'p3', color: 'violet', glyph: '3' },
  { title: 'Transformers & LLMs',         caption: 'Attention from scratch, pre-training, SFT/DPO, MoE & reasoning',   accent: 'p4', color: 'yellow', glyph: '4' },
  { title: 'Systems & Production',        caption: 'Distributed training, inference engines, MLOps, safety',           accent: 'p5', color: 'red',    glyph: '5' },
  { title: 'Specialization & Interview',  caption: 'Pick two of three tracks, capstone, 7-day interview protocol',     accent: 'p6', color: 'pink',   glyph: '6' },
] as const

const parts = PART_META.map((meta, i) => ({
  ...meta,
  part: i + 1,
  weeks: weeks.filter((w) => w.data.part === i + 1),
}))

const totalHours = weeks.reduce((sum, w) => sum + (w.data.hours ?? 20), 0)
---
<BookShell title="Home">
  {/* --- Hero: giant stickered title on a kraft-paper card --- */}
  <section class="relative mb-16">
    <div
      class="toy-card relative overflow-hidden"
      style="background: var(--paper-2); padding: 44px 32px 60px;"
    >
      <div
        class="absolute inset-x-0 top-0 h-2"
        style="background: var(--gradient-roadmap);"
        aria-hidden="true"
      ></div>

      {/* floating sticker up-right */}
      <span class="toy-sticker red hidden sm:inline-flex absolute right-6 top-10 text-sm">
        25 weeks ·  7 labs ·  3 tracks
      </span>

      <h1 class="toy-title text-5xl sm:text-6xl md:text-7xl">Core AI</h1>
      <p class="font-display text-2xl sm:text-3xl mt-6" style="color: var(--ink);">
        From foundation to frontier.
      </p>
      <p class="mt-5 max-w-xl text-md leading-relaxed" style="color: var(--ink-soft); font-weight: 700;">
        A self-driven roadmap from the math you need to the systems people deploy. Each week ships one tested reference project, one Company Lens across seven labs, and one interview drill. Practice and feedback — not completion alone — build interview readiness.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/weeks/week-01-linear-algebra" class="toy-btn blue">Start Week 1 →</a>
        <a href="/how-to-study" class="toy-btn paper">How to study this book</a>
      </div>

      {/* stats row — four toy blocks */}
      <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-5 max-w-2xl">
        <div class="toy-card-sm p-4" style="background: var(--paper);">
          <p class="font-mono text-xs uppercase tracking-wider" style="color: var(--ink-soft); font-weight: 800;">Weeks</p>
          <p class="font-display text-4xl mt-1" style="color: var(--blue);">{weeks.length}</p>
        </div>
        <div class="toy-card-sm p-4" style="background: var(--paper);">
          <p class="font-mono text-xs uppercase tracking-wider" style="color: var(--ink-soft); font-weight: 800;">Study hours</p>
          <p class="font-display text-4xl mt-1" style="color: var(--green);">{totalHours}+</p>
        </div>
        <div class="toy-card-sm p-4" style="background: var(--paper);">
          <p class="font-mono text-xs uppercase tracking-wider" style="color: var(--ink-soft); font-weight: 800;">Companies</p>
          <p class="font-display text-4xl mt-1" style="color: var(--violet);">7</p>
        </div>
        <div class="toy-card-sm p-4" style="background: var(--paper);">
          <p class="font-mono text-xs uppercase tracking-wider" style="color: var(--ink-soft); font-weight: 800;">Projects</p>
          <p class="font-display text-4xl mt-1" style="color: var(--red);">25</p>
        </div>
      </div>
    </div>
  </section>

  {/* --- The six parts headline --- */}
  <section class="mb-8">
    <span class="toy-sticker violet text-sm">The six parts</span>
    <h2 class="font-display text-3xl sm:text-4xl mt-5" style="letter-spacing: -0.01em;">
      One deliberately shaped arc per month.
    </h2>
    <p class="mt-3 max-w-xl text-md" style="color: var(--ink-soft); font-weight: 700;">
      Each week carries the same anatomy: hook → intuition → math → code → company lens → reference project → assignments → interview drill.
    </p>
  </section>

  {/* --- 6 Month cards — each a toy-block headline + sticker weeks list --- */}
  <div class="grid gap-6 md:grid-cols-2 mb-16">
    {parts.map(({ part, title, caption, accent, color, glyph, weeks }) => (
      <article
        class="toy-card relative overflow-visible p-6 sm:p-8"
        style={`--accent: var(--${color}); --ink-accent: var(--accent-ink-${accent}); --glow: var(--accent-glow-${accent}); background: var(--glow);`}
      >
        {/* corner block number */}
        <div
          class="absolute -top-6 -left-3 toy-block"
          style={`width: 76px; height: 76px; background: var(--${color}); transform: rotate(-6deg);`}
        >
          <div class="glyph" style={`font-size: 44px; color: ${['yellow','pink'].includes(color) ? 'var(--ink)' : 'var(--paper)'};`}>{glyph}</div>
        </div>
        <header class="pl-20 min-h-[76px]">
          <p class="font-mono text-xs uppercase tracking-widest" style="color: var(--ink-soft); font-weight: 900;">
            Month {part} · {weeks.length} weeks
          </p>
          <h3 class="font-display text-2xl sm:text-3xl mt-1" style="letter-spacing: -0.01em;">
            {title}
          </h3>
        </header>
        <p class="mt-4 text-sm max-w-md" style="color: var(--ink-soft); font-weight: 700;">{caption}</p>
        <ol class="mt-5 space-y-1.5">
          {weeks.map((w) => (
            <li>
              <a
                href={`/weeks/${w.data.slug}`}
                class="group flex items-center gap-3 py-1.5 px-3 -mx-3 rounded-md transition-colors hover:bg-canvas"
              >
                <span
                  class="font-mono text-xs w-12 shrink-0 font-black"
                  style="color: var(--ink-accent);"
                >
                  W{weekLabel(w.data)}
                </span>
                <span class="flex-1 font-bold group-hover:translate-x-0.5 transition-transform">
                  {w.data.title}
                </span>
                <span class="text-xs font-black shrink-0" style="color: var(--ink-soft);">{w.data.hours}h</span>
              </a>
            </li>
          ))}
        </ol>
        {part === 6 && (
          <p class="relative mt-5 text-xs font-bold" style="color: var(--ink-soft);">
            Pick 2 of 3 tracks (L · P · R). All six α/β lessons are available.
          </p>
        )}
      </article>
    ))}
  </div>

  {/* --- Companies CTA — big playful card with 7 stickers --- */}
  <section
    class="toy-card relative mb-16 p-6 sm:p-10 overflow-hidden"
    style="background: var(--paper);"
  >
    <span class="toy-sticker green absolute right-6 top-6 text-sm">Lab x Weeks</span>
    <h2 class="font-display text-3xl sm:text-4xl" style="letter-spacing: -0.01em;">
      Seven labs. Twenty-five weeks.
    </h2>
    <p class="mt-3 max-w-xl text-md" style="color: var(--ink-soft); font-weight: 700;">
      Every week compares the same seven labs so comparisons compound. By Week 25, 175 interview angles are internalized.
    </p>
    <div class="mt-5 flex flex-wrap gap-2">
      {[
        {name: 'OpenAI', color: 'violet'},
        {name: 'Anthropic', color: 'red'},
        {name: 'Google DeepMind', color: 'blue'},
        {name: 'Meta', color: 'blue'},
        {name: 'xAI', color: 'paper'},
        {name: 'DeepSeek', color: 'yellow'},
        {name: 'Alibaba Qwen', color: 'pink'},
      ].map((lab) => (
        <span class={`toy-sticker ${lab.color} text-sm`} style="transform: rotate(-1deg);">{lab.name}</span>
      ))}
    </div>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href="/companies" class="toy-btn blue">Open the matrix →</a>
      <a href="/companies/compare" class="toy-btn paper">Compare on an axis</a>
    </div>
  </section>
</BookShell>
