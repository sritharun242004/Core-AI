---
import { getEntry, render } from 'astro:content'
import ExtraLayout from '../layouts/ExtraLayout.astro'
const entry = await getEntry('extras', 'paper-reading-protocol')
if (!entry) throw new Error('missing extras entry: paper-reading-protocol')
const { Content } = await render(entry)
---
<ExtraLayout frontmatter={entry.data}>
  <Content />
</ExtraLayout>
