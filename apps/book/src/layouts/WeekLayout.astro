---
import { getCollection } from 'astro:content'
import ComputeBadge from '../components/content/ComputeBadge.astro'
import BookShell from '../components/layout/BookShell.astro'
import { weekLabel } from '../lib/weeks'
interface Props {
  frontmatter: {
    week: number
    slug: string
    part: number
    title: string
    hook: string
    hours: number
    computeTier: 'green' | 'yellow' | 'red'
    difficulty: number
    accentVar: string
    prereqSlugs?: string[]
  }
}
const { frontmatter } = Astro.props
const lessons = await getCollection('weeks')
const prerequisites = (frontmatter.prereqSlugs ?? [])
  .map((slug) => lessons.find((lesson) => lesson.data.slug === slug))
  .filter(Boolean)
---
<BookShell title={frontmatter.title} accent={`var(${frontmatter.accentVar})`}>
  <header class="mb-8">
    <p class="text-fg-muted text-sm">Week {weekLabel(frontmatter)} · Part {frontmatter.part} · {frontmatter.hours} hrs · Difficulty {'▮'.repeat(frontmatter.difficulty) + '▯'.repeat(5 - frontmatter.difficulty)}</p>
    <h1 class="font-display text-4xl sm:text-5xl mt-2 break-words">{frontmatter.title}</h1>
    <div class="mt-3"><ComputeBadge tier={frontmatter.computeTier} /></div>
    {prerequisites.length > 0 && (
      <nav aria-label="Prerequisites" class="mt-4 text-sm text-fg-muted">
        <p>Before this lesson:</p>
        <ul class="mt-1 space-y-1">
          {prerequisites.map((lesson) => lesson && <li><a class="underline" href={`/weeks/${lesson.data.slug}`}>W{weekLabel(lesson.data)} — {lesson.data.title}</a></li>)}
        </ul>
      </nav>
    )}
  </header>
  <article class="prose-book"><slot /></article>
</BookShell>
