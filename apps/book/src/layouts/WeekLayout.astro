---
import { getCollection } from 'astro:content'
import ComputeBadge from '../components/content/ComputeBadge.astro'
import BookShell from '../components/layout/BookShell.astro'
import PageTOC from '../components/layout/PageTOC.astro'
import { weekLabel } from '../lib/weeks'
interface Props {
  frontmatter: {
    week: number
    slug: string
    part: number
    title: string
    hook: string
    hours: number
    computeTier: 'green' | 'yellow' | 'red'
    difficulty: number
    accentVar: string
    prereqSlugs?: string[]
  }
}
const { frontmatter } = Astro.props
const PART_META = [
  { title: 'Math & Programming',          color: 'blue'   },
  { title: 'Classical ML',                color: 'green'  },
  { title: 'Deep Learning',               color: 'violet' },
  { title: 'Transformers & LLMs',         color: 'yellow' },
  { title: 'Systems & Production',        color: 'red'    },
  { title: 'Specialization & Interview',  color: 'pink'   },
] as const
const partMeta = PART_META[frontmatter.part - 1]
const accentIx = `p${frontmatter.part}`
const lessons = await getCollection('weeks')
const prerequisites = (frontmatter.prereqSlugs ?? [])
  .map((slug) => lessons.find((lesson) => lesson.data.slug === slug))
  .filter(Boolean)
---
<BookShell title={frontmatter.title} accent={`var(${frontmatter.accentVar})`}>
  <header
    class="toy-card relative mb-12 p-6 sm:p-10 overflow-visible"
    style={`background: var(--accent-glow-${accentIx});`}
  >
    {/* floating sticker with month */}
    <span class={`toy-sticker ${partMeta.color} absolute right-5 -top-5 text-sm`} style="transform: rotate(3deg);">
      Month {frontmatter.part}
    </span>

    <p class="font-mono text-xs uppercase tracking-widest font-black" style="color: var(--ink-soft);">
      Week {weekLabel(frontmatter)} — {partMeta.title}
    </p>
    <h1
      class="font-display text-4xl sm:text-5xl md:text-6xl mt-4 break-words leading-none"
      style="letter-spacing: -0.015em;"
    >
      {frontmatter.title}
    </h1>
    <p class="mt-5 max-w-2xl text-md leading-relaxed" style="color: var(--ink-soft); font-weight: 700;">
      {frontmatter.hook}
    </p>

    {/* meta chips row */}
    <div class="mt-6 flex flex-wrap items-center gap-3 text-sm font-black">
      <ComputeBadge tier={frontmatter.computeTier} />
      <span class="toy-card-sm px-3 py-1.5 inline-flex items-center gap-2">
        <span class="font-mono text-xs" style="color: var(--ink-soft);">Hours</span>
        <span>{frontmatter.hours}</span>
      </span>
      <span class="toy-card-sm px-3 py-1.5 inline-flex items-center gap-2">
        <span class="font-mono text-xs" style="color: var(--ink-soft);">Difficulty</span>
        <span class="font-mono" style={`color: var(--${partMeta.color}-dark);`}>
          {'●'.repeat(frontmatter.difficulty)}<span style="color: color-mix(in oklab, var(--ink-soft) 40%, transparent);">{'○'.repeat(5 - frontmatter.difficulty)}</span>
        </span>
      </span>
    </div>

    {prerequisites.length > 0 && (
      <nav aria-label="Prerequisites" class="mt-6">
        <p class="font-mono text-xs uppercase tracking-widest font-black" style="color: var(--ink-soft);">
          Before this lesson
        </p>
        <ul class="mt-2 flex flex-wrap gap-2">
          {prerequisites.map((lesson) => lesson && (
            <li>
              <a
                class="toy-card-sm inline-flex items-center gap-2 px-3 py-1.5 text-sm no-underline"
                href={`/weeks/${lesson.data.slug}`}
              >
                <span class="font-mono text-xs" style="color: var(--ink-soft);">W{weekLabel(lesson.data)}</span>
                <span class="font-black">{lesson.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </header>
  <div class="grid xl:grid-cols-[minmax(0,1fr)_240px] gap-10 xl:gap-14 items-start">
    <article class="prose-book min-w-0"><slot /></article>
    <PageTOC color={partMeta.color} />
  </div>
</BookShell>
